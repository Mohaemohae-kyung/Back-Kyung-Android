# 줄바꿈 정규화 — 저장소는 LF, Windows 작업 디렉토리는 자동 CRLF 변환
* text=auto eol=lf

# 명시적 텍스트 + LF
*.kt        text eol=lf
*.kts       text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.properties text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.pro       text eol=lf
*.cmake     text eol=lf
*.cpp       text eol=lf
*.h         text eol=lf
*.hpp       text eol=lf
*.c         text eol=lf

# Gradle Wrapper — 반드시 LF (실행 가능 셸 스크립트)
gradlew     text eol=lf

# Windows 배치 — 반드시 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 바이너리 (변환 금지)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.svg       binary
*.apk       binary
*.aab       binary
*.jar       binary
*.so        binary
*.class     binary
*.dex       binary
*.keystore  binary
*.jks       binary
*.pdf       binary
*.zip       binary
*.gz        binary
